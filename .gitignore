# Nuxt / Nitro build output
.output
.nuxt
.nitro
.cache
.data

# Cloudflare / Wrangler
.wrangler
.mf
.dev.vars
dist

# Dependencies
node_modules/

# Local env files. There are none to check in: this app takes no local
# configuration — bindings come from wrangler.jsonc, and deploy-time values from
# GitHub variables and secrets (see README.md § Deploying your own fork).
.env
.env.*

# Logs
*.log
logs/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/

# Test & coverage
coverage/
*.tsbuildinfo

# Screen recordings. The README embeds skein-demo.gif, which is committed; the
# mp4s a recording starts life as are not, because a repository keeps whatever
# lands in it forever and a demo video is the first thing re-recorded when the
# UI changes. Keep them somewhere else.
*.mp4
